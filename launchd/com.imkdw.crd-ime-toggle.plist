<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 템플릿: scripts/install.sh 가 __BIN__, __LOG__ 를 채우고 추가 인자를 ProgramArguments 뒤에 붙인다 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.imkdw.crd-ime-toggle</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
